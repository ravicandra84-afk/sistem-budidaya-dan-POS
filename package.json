{
  "name": "pfi-operational-system",
  "version": "1.0.0",
  "private": true,
  "packageManager": "npm@11.20.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "workspaces": [
    "apps/api",
    "apps/web",
    "packages/shared"
  ],
  "overrides": {
    "deepmerge-ts": "8.0.2"
  },
  "scripts": {
    "build": "npm run build --workspace @pfi/shared && npm run build --workspace @pfi/api && npm run build --workspace @pfi/web",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run build --workspace @pfi/shared && npm run test --workspace @pfi/api",
    "db:generate": "npm run db:generate --workspace @pfi/api",
    "db:migrate:deploy": "npm run db:migrate:deploy --workspace @pfi/api",
    "db:seed:species": "npm run db:seed:species --workspace @pfi/api",
    "db:provision-owner": "npm run db:provision-owner --workspace @pfi/api",
    "db:provision-runtime-role": "npm run db:provision-runtime-role --workspace @pfi/api"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@next/eslint-plugin-next": "16.4.6",
    "eslint": "9.39.5",
    "globals": "16.5.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.2"
  }
}
