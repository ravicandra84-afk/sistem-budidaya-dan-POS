{
  "name": "@pfi/api",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "jest --config jest.config.cjs --passWithNoTests",
    "db:generate": "tsx scripts/prisma-cli.ts generate --schema prisma/schema.prisma",
    "db:migrate:deploy": "tsx scripts/prisma-cli.ts migrate deploy --schema prisma/schema.prisma",
    "db:seed:species": "tsx prisma/seed-species.ts",
    "db:provision-owner": "tsx prisma/provision-owner.ts",
    "db:provision-runtime-role": "tsx prisma/provision-runtime-role.ts"
  },
  "dependencies": {
    "@nestjs/common": "11.2.10",
    "@nestjs/core": "11.2.10",
    "@nestjs/platform-express": "11.2.10",
    "@pfi/shared": "*",
    "@prisma/client": "6.19.3",
    "bcryptjs": "3.0.3",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "dotenv": "17.2.3",
    "jsonwebtoken": "9.0.3",
    "@nestjs/throttler": "6.8.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/express": "5.0.3",
    "@types/jest": "30.0.0",
    "@types/jsonwebtoken": "9.0.10",
    "@types/node": "26.0.0",
    "@types/supertest": "6.0.3",
    "jest": "30.5.2",
    "@nestjs/testing": "11.2.10",
    "prisma": "6.19.3",
    "supertest": "7.3.2",
    "ts-jest": "29.4.5",
    "tsx": "4.23.15"
  }
}
