# ==============================================================================
# PISCICULTURE FARM INDONESIA (PFI) — ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# PETUNJUK PENGGUNAAN:
# 1. Salin file ini menjadi file lokal bernama `.env` (contoh: `cp .env.example .env`).
# 2. Isi seluruh nilai placeholder (`CHANGE_ME_...`) pada file `.env` lokal Anda.
# 3. JANGAN PERNAH melakukan commit atau mengunggah file `.env` asli ke Git/GitHub.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. APLIKASI & ZONA WAKTU BISNIS (LOCKED — V4.5)
# ------------------------------------------------------------------------------
NODE_ENV=development
APP_NAME="Pisciculture Farm Indonesia (PFI)"

# Zona waktu bisnis wajib Asia/Jakarta (UTC+7) untuk validasi entry_date
# serta penomoran harian batch (PFI-BCH) dan penjualan (PFI-SAL).
TZ=Asia/Jakarta

# Konfigurasi Server Backend REST API (Node.js + TypeScript)
PORT=4000
API_PREFIX=/api/v1

# ------------------------------------------------------------------------------
# 2. KONEKSI FRONTEND & CORS (DECOUPLED ARCHITECTURE)
# ------------------------------------------------------------------------------
FRONTEND_URL=http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Variabel sisi klien (sesuaikan dengan framework frontend yang dikunci pada P0-02):
# - Jika menggunakan Next.js:
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000/api/v1
# - Jika menggunakan Vue.js / Vite:
VITE_API_BASE_URL=http://localhost:4000/api/v1

# ------------------------------------------------------------------------------
# 3. DATABASE POSTGRESQL 13+ (GRANULAR PRIVILEGE SEPARATION — V4.5)
# ------------------------------------------------------------------------------
# Sesuai Master Blueprint V4.5 Bagian 3.2, koneksi database dipisah menjadi 2 role:
#
# A. App Runtime Role (DML Granular / Least Privilege):
#    Digunakan oleh aplikasi backend saat berjalan. Hanya memiliki hak SELECT &
#    INSERT pada tabel append-only (incoming_fish, incoming_fish_voids,
#    audit_logs, fish_sales, fish_sale_voids) tanpa hak UPDATE/DELETE.
DATABASE_URL="postgresql://pfi_app_runtime:CHANGE_ME_RUNTIME_DB_PASSWORD@localhost:5432/pfi_operational?schema=public&timezone=Asia/Jakarta"

# B. Migration Role (DDL Admin):
#    Hanya digunakan saat menjalankan skrip migrasi skema, trigger, dan seeding.
MIGRATION_DATABASE_URL="postgresql://pfi_migration_admin:CHANGE_ME_MIGRATION_DB_PASSWORD@localhost:5432/pfi_operational?schema=public&timezone=Asia/Jakarta"

# C. Database Khusus Pengujian Otomatis (Integration & 32 TC V4.5):
TEST_DATABASE_URL="postgresql://pfi_migration_admin:CHANGE_ME_TEST_DB_PASSWORD@localhost:5432/pfi_test?schema=public&timezone=Asia/Jakarta"

# Pengaturan Pool & Lock Timeout (untuk penanganan 503 DATABASE_LOCK_TIMEOUT / TC-18)
DB_POOL_MAX=20
DB_LOCK_TIMEOUT_MS=5000

# ------------------------------------------------------------------------------
# 4. AUTENTIKASI JWT & KEAMANAN KATA SANDI (FR-AUTH-01 & NFR-SEC-01)
# ------------------------------------------------------------------------------
# Gunakan string acak minimal 32-64 karakter (misal: `openssl rand -hex 32`)
JWT_SECRET="CHANGE_ME_GENERATE_STRONG_RANDOM_SECRET_KEY_MIN_32_CHARS"
JWT_EXPIRES_IN="8h"
JWT_ISSUER="pfi-operational-api"
JWT_AUDIENCE="pfi-internal-clients"

# Biaya hashing password pengguna
BCRYPT_SALT_ROUNDS=12

# ------------------------------------------------------------------------------
# 5. RATE LIMITING & IDEMPOTENCY (NFR-04 & ERROR 429)
# ------------------------------------------------------------------------------
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# ------------------------------------------------------------------------------
# 6. PROVISIONING AKUN AWAL LOKAL (TBD-08 — HANYA UNTUK SEEDING DEVELOPMENT)
# ------------------------------------------------------------------------------
# Alur administrasi akun final masih berstatus TBD-08. Variabel di bawah hanya
# digunakan jika skrip seed lokal membutuhkan akun uji awal.
# SEED_INITIAL_OWNER_EMAIL="owner.local@pfi.internal"
# SEED_INITIAL_OWNER_PASSWORD="CHANGE_ME_LOCAL_DEV_PASSWORD"

# ------------------------------------------------------------------------------
# 7. CATATAN INTEGRASI EKSTERNAL (OUT OF SCOPE)
# ------------------------------------------------------------------------------
# Sistem PFI MVP TIDAK menggunakan API pihak ketiga (Payment Gateway, ERP, CRM,
# maupun layanan analitik eksternal). Jangan menambahkan API key eksternal di sini.